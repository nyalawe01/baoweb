{
  "name": "@bao/cms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx watch server.ts",
    "prebuild": "npm --prefix ../../packages/shared run build",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "postbuild": "node -e \"const fs=require('fs'); if(fs.existsSync('dist/client')) fs.cpSync('dist/client', 'dist', {recursive:true}); fs.writeFileSync('dist/package.json', JSON.stringify({type:'module',main:'server.js'},null,2)); if(fs.existsSync('dist/server.js')) fs.copyFileSync('dist/server.js', 'dist/server.mjs');\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bao/shared": "*",
    "@supabase/supabase-js": "^2.48.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "isomorphic-dompurify": "^2.21.0",
    "lucide-react": "^0.469.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "tailwindcss": "^4.0.0"
  }
}

