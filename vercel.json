{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bao-website": {
      "root": "apps/bao-website",
      "framework": "express",
      "entrypoint": "server.ts",
      "buildCommand": "npm run build",
      "bindings": [
        {
          "type": "service",
          "service": "bao-cms",
          "format": "url",
          "env": "CMS_URL"
        }
      ]
    },
    "bao-cms": {
      "root": "apps/bao-cms",
      "framework": "express",
      "entrypoint": "server.ts",
      "buildCommand": "npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "cms\\..*"
        }
      ],
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*-cms.*"
        }
      ],
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/cms/assets/(.*)",
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/api/v1",
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/cms",
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/cms/(.*)",
      "destination": {
        "service": "bao-cms"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "bao-website"
      }
    }
  ]
}

